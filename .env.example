# Your own Helius API key. Create one at https://dashboard.helius.dev
# Leave this as the placeholder until you copy this file to .env.
# .env is gitignored. Do not commit a real key.
HELIUS_API_KEY=your_helius_api_key

# devnet (default) or mainnet
ZOLANA_CLUSTER=devnet

# Optional full RPC URL. Leave empty to use Helius when HELIUS_API_KEY is set,
# or public Solana RPC when it is not. Do not put a real key in this file.
SOLANA_RPC_URL=
